# ThirdPlace frontend — public runtime config.
# Copy to .env.local for development. NEVER commit real values.
# Only EXPO_PUBLIC_* vars are exposed to the client bundle; never put
# service-role keys or any secret here.

# Backend base URL (no routes are consumed in Phase 0).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase public config (anon key only — never the service_role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
