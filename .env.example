# ThirdPlace frontend — public runtime config.
# Copy to .env.local for development. NEVER commit real values.
# Only EXPO_PUBLIC_* vars are exposed to the client bundle; never put
# service-role keys or any secret here.

# Backend base URL (no routes are consumed in Phase 0).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase public config (anon key only — never the service_role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox PUBLIC access token (pk.*) — safe to ship in the client. Enables the
# real map in a native dev/EAS build. Without it the app shows the SoftMap
# placeholder (and Expo Go always uses the placeholder).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox DOWNLOADS token (sk.* — SECRET, build-time only). Needed to fetch the
# native Mapbox SDK during a dev/EAS build. Set it in your shell or EAS secrets;
# NEVER commit a real value. Read by app.config.ts.
# MAPBOX_DOWNLOADS_TOKEN=
