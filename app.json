{
  "expo": {
    "name": "ThirdPlace",
    "slug": "thirdplace",
    "scheme": "thirdplace",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thirdplace.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thirdplace.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF385C"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FF385C"
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-calendar",
        {
          "calendarPermission": "ThirdPlace legger opplevelser du velger inn i kalenderen din.",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "ThirdPlace legger opplevelser du velger inn i kalenderen din.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b76deae0-699b-4797-997d-e3a2c884d8ca"
      }
    }
  }
}
