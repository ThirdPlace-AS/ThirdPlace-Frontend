{
  "expo": {
    "name": "ThirdPlace",
    "slug": "thirdplace",
    "scheme": "thirdplace",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thirdplace.app"
    },
    "android": {
      "package": "com.thirdplace.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "@rnmapbox/maps"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b76deae0-699b-4797-997d-e3a2c884d8ca"
      }
    }
  }
}
