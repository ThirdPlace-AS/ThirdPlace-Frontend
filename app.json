{
  "expo": {
    "name": "ThirdPlace",
    "slug": "thirdplace",
    "scheme": "thirdplace",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-font", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
